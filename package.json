{
  "name": "samvit-os",
  "version": "12.1.0",
  "private": true,
  "type": "module",
  "description": "Samvit — a multi-model AI workspace evolving into an autonomous intelligence OS, with a permissioned bridge to a user's own paired computer.",
  "scripts": {
    "dev": "netlify dev",
    "test": "node --experimental-test-module-mocks --test tests/*.test.js",
    "check-imports": "node scripts/check-imports.mjs",
    "build": "node scripts/check-imports.mjs && node scripts/build.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.11",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "netlify-cli": "^27.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
