# Copy to .env for Netlify dev. Do not commit real credentials.
# ── V14 identity ─────────────────────────────────────────────────────────
# Registration is OPEN. Anyone can sign up with an email + password; the
# account activates by verifying its email. There is no invitation code,
# no owner-claim page, and no "first user becomes owner" rule. The
# authenticated account is the identity boundary.
#
# ACCESS_CODE is now ONLY the explicit local-development mode key: when it
# is unset AND DEV_MODE=true, the app opens without sign-in on localhost.
# It never gates registration and is not a shared login anymore.
ACCESS_CODE=
# Operator-designated administrators (comma-separated emails) for the
# billing-operations console. This is configuration, not a claim flow.
# SAMVIT_ADMIN_EMAILS=ops@example.com,founder@example.com
# Generate and persist independent secrets in private Netlify Blobs.
SAMVIT_AUTO_SECRETS=true
# Explicit values override auto-generation. Preserve existing values on upgrade.
SESSION_SECRET=
SAMVIT_KEY_ENCRYPTION_SECRET=
# Explicit local development bypass; production always ignores it.
DEV_MODE=false

# Optional: add keys here, or sign in and use Connections.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_COUNCIL_PER_MINUTE=5
# Only lowers each account's plan allowance.
# SAMVIT_MONTHLY_BUDGET_USD=1

# Stripe TEST only. Live keys never enable checkout in this version.
SAMVIT_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_MAP={"price_examplepro":"pro","price_exampleultra":"ultra"}
STRIPE_STUDENT_DISCOUNT_COUPON_ID=
# Trusted verifier adapter: a separate random 32+ character signing secret.
SAMVIT_STUDENT_VERIFIER_SECRET=
# Old SAMVIT_VERIFIED_STUDENT_ACCOUNTS lists are no longer consulted.

# Optional trusted HTTPS gateway API base, ending in /v1.
# SAMVIT_OMNIROUTE_BASE_URL=https://your-authorized-gateway.example/v1
# Needed ONLY for connection management in explicit unauthenticated DEV_MODE.
SAMVIT_CONNECTIONS_ADMIN_CODE=

# ── V14 email ────────────────────────────────────────────────────────────
# Production email: Resend. Verified sender/domain required.
RESEND_API_KEY=
SAMVIT_EMAIL_FROM=
SAMVIT_PUBLIC_ORIGIN=
# Development alternative (never real inboxes): capture every message into a
# local blob outbox you can inspect. Ignored when RESEND_API_KEY is set.
# SAMVIT_EMAIL_PROVIDER=dev

# Student verification: published SheerID program; API Access Control requireToken enabled.
# Access token needs Verification Details + Customer PII to compare verified account email.
SHEERID_ACCESS_TOKEN=
SHEERID_PROGRAM_ID=
SHEERID_WEBHOOK_SECRET=
# Hosted verifier receives any evidence; Samvit never accepts student ID images.

# V9 durable missions use SAMVIT_PUBLIC_ORIGIN above (your deployed HTTPS origin).
# Enable Netlify background and scheduled functions. The dispatcher runs each minute.
# Search requires both a Brave key and a positive conservative cost per request.
BRAVE_SEARCH_API_KEY=
SAMVIT_SEARCH_COST_USD=
# Optional semantic retrieval: explicit per-mission permission is also required.
SAMVIT_SEMANTIC_MEMORY=false
# Conservative input-token price for text-embedding-3-small, USD per million.
SAMVIT_EMBEDDING_USD_PER_MILLION=

# v12 desktop bridge: deployment-wide emergency stop (16+ characters).
# Without it the global stop stays unavailable (503) — it never opens by default.
SAMVIT_OPERATOR_SECRET=
